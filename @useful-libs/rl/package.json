{
  "name": "@useful-libs/rl",
  "version": "0.0.1",
  "description": "Readline prompt wrapper with colored output and validation",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
